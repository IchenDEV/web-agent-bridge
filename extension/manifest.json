{
  "manifest_version": 3,
  "name": "Web Agent Bridge",
  "version": "0.3.0",
  "description": "Bridge online web AI agents (Doubao, WorkBuddy, etc.) to A2A protocol endpoints",
  "permissions": [
    "activeTab",
    "scripting",
    "tabs",
    "alarms",
    "storage"
  ],
  "host_permissions": [
    "*://www.doubao.com/*",
    "*://www.workbuddy.cn/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["*://www.doubao.com/*"],
      "js": ["adapters/doubao.js", "content.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["*://www.workbuddy.cn/*"],
      "js": ["adapters/workbuddy.js", "content.js"],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png"
    }
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  }
}
